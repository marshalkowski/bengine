# ---- Build output / generated CMake files ----
build/
out/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
_deps/

# ---- Compiler / linker artifacts ----
*.obj
*.o
*.exe
*.dll
*.pdb
*.ilk
*.exp
*.lib
*.a
*.out

# ---- Visual Studio (generated by the CMake VS generator / open-folder) ----
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# ---- OS-specific ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Editor-local (VS Code) ----
# Entire .vscode/ is ignored: launch.json / settings.json here are usually
# machine-specific (compiler paths, debugger config). If we later want to
# share a common settings.json with the team, we can un-ignore that one file.
.vscode/

# ---- Claude Code: local/session-only files ----
# settings.local.json holds this machine's personal tool-permission choices
# and is regenerated per user/session — not something to share via git.
# CLAUDE.md and any project-level .claude/agents, .claude/skills, etc. are
# NOT ignored: they document the project itself and should travel with it.
.claude/settings.local.json
